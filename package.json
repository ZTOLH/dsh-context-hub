{
  "name": "dsh-context-hub",
  "version": "1.0.0",
  "description": "资料库与提示词管理：统一管理检索资料和系统提示词",
  "license": "MIT",
  "author": "DSH Community",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-hub",
    "resource-library",
    "prompt-manager",
    "sidebar"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/resource-library.js",
    "lib/prompt-manager.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
